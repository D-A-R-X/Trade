# Telegram API credentials — get these from https://my.telegram.org
API_ID=1234567
API_HASH=your_api_hash_here

# The channel to listen to. Use @username, a t.me link, or the numeric ID.
# For the "PREMIUM V2" channel in your screenshots, use its @username or invite.
CHANNEL=@your_channel_here

# Where to store the local database and Telethon session
DB_PATH=signals.db
SESSION_NAME=signal_tracker

# Your local timezone offset used by the channel (screenshots show UTC +5:30).
# Entry times in signals are interpreted in this offset.
SIGNAL_UTC_OFFSET=+05:30

# Price adapter for INDEPENDENT outcome verification.
#   none   -> only track the channel's own claimed GAIN/LOSS posts
#   quotex -> use the unofficial Quotex DEMO feed (requires pyquotex, see pricefeed.py)
PRICE_ADAPTER=none

# Only needed if PRICE_ADAPTER=quotex. Use a DEMO account. Never commit real creds.
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
